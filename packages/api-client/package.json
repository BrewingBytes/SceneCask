{
  "name": "@scenecask/api-client",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/generated/schema.ts"
  },
  "imports": {
    "#generated/*": "./src/generated/*.ts"
  },
  "scripts": {
    "api:generate": "node scripts/generate.mjs",
    "api:check": "yarn lint && yarn test && yarn typecheck && node scripts/generate.mjs --check",
    "lint": "redocly lint ../../contracts/openapi.yaml --config redocly.yaml",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && yarn workspace @scenecask/web exec tsc --project ../../packages/api-client/tsconfig.web-consumer.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.53.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
