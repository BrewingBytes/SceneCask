  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
