{
  "name": "scenecask",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:services": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "lint": "yarn workspace @scenecask/web lint && cargo fmt --manifest-path services/api/Cargo.toml --check && cargo clippy --manifest-path services/api/Cargo.toml --locked --all-targets -- -D warnings",
    "typecheck": "yarn workspace @scenecask/web typecheck",
    "build": "yarn workspace @scenecask/web build && cargo build --manifest-path services/api/Cargo.toml --locked",
    "test": "cargo test --manifest-path services/api/Cargo.toml --locked",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "test:e2e": "playwright test",
    "health:smoke": "node scripts/health-smoke.mjs",
    "test:design": "node apps/web/src/styles/generate-tokens.mjs --check && node --test apps/web/src/styles/generate-tokens.test.mjs apps/web/src/components/ui/basic/child-exit.test.mjs apps/web/src/components/ui/basic/gallery-workspace.test.mjs",
    "test:ui": "playwright test --config apps/web/src/components/ui/basic/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
