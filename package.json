{
  "name": "scenecask",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:services": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "lint": "pnpm --filter @scenecask/web lint && cargo fmt --manifest-path services/api/Cargo.toml --check && cargo clippy --manifest-path services/api/Cargo.toml --locked --all-targets -- -D warnings",
    "typecheck": "pnpm --filter @scenecask/web typecheck",
    "build": "pnpm --filter @scenecask/web build && cargo build --manifest-path services/api/Cargo.toml --locked",
    "test": "cargo test --manifest-path services/api/Cargo.toml --locked",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "test:e2e": "playwright test",
    "health:smoke": "node scripts/health-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
