# Local disposable development credentials only; never use these in deployment.
DATABASE_URL=postgres://scenecask:scenecask_local@127.0.0.1:54329/scenecask
API_BIND=127.0.0.1:8080
# Where Next.js forwards /api/v1 and /health (server-side only).
API_ORIGIN=http://127.0.0.1:8080
# The browser-facing origin; the API checks mutation Origin against it and builds email links.
PUBLIC_ORIGIN=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=10259
# Apply pending migrations when the API starts (development/CI). Deployments migrate explicitly.
API_MIGRATE_ON_START=true
# Social beta routes and UI; off unless exactly "true". Read by both the API and Next.js.
SCENECASK_BETA=false
# Optional provider credentials (server-only, never NEXT_PUBLIC_*). Without TMDB_API_TOKEN, search
# and import answer 502; without Google credentials, Google sign-in routes are not mounted.
# TMDB_API_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
